.deploy-id
.vercel
# Archives
*.zip
# Journaux et fichiers système
*.log
.DS_Store
Thumbs.db
.env*

# Artefacts régénérables du playbook scripts/repo-hygiene.sh (audit-only)
.repo-hygiene*/

# Worktrees git locaux des sessions parallèles. Sans cette règle, un
# `git add -A` les indexe comme liens git et les committe.
.claude/worktrees/
